# Supabase project URL and server-only secret key (sb_secret_...).
# Add these to .env.local for local development and to Vercel server environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-sb-secret-key

# Optional server-only key for grounded Ask Relay answers.
GEMINI_API_KEY=replace-with-your-gemini-api-key
